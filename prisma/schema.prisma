// 社内成績管理アプリ Phase1 — Prisma schema
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Enums (要件 7章) =====

enum Role {
  Admin
  User
}

enum EmploymentType {
  Proper
  Outsource
}

enum Gender {
  Male
  Female
  Other
  Unknown
}

// 役職（給与グレード / 大枠）。給与テーブルの選択に対応。
enum Grade {
  Analyst // アナリスト
  Associate // アソシエイト
  Consultant // コンサルタント
  SeniorConsultant // シニアコンサルタント
  Manager // マネージャー
  SeniorManager // シニアマネージャー
  Director // ディレクター
  Partner // パートナー
}

enum SalesStatus {
  Actual
  Forecast
}

// 計上経費（コスト）の区分（売上には計上しない支出。将来の利益計算用に記録）
enum ExpenseType {
  Transportation // 交通費
  Reimbursement // 立替経費
  Other // その他
}

// 契約区分（サイドバー「売上一覧」の準委任/請負委任/その他）
enum ContractType {
  SemiDelegation // 準委任
  Contract // 請負委任
  Other // その他
}

// ===== User (要件 6-1) =====
model User {
  id         String   @id @default(cuid())
  role       Role     @default(User)
  login_id   String   @unique
  login_pw   String // bcrypt ハッシュを保存（平文保存しない）
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Member との 1:1（FK は Member 側が保持）
  linked_member Member? @relation("UserMember")

  // SalesEntry の登録者 / 更新者
  created_sales SalesEntry[] @relation("SalesCreatedBy")
  updated_sales SalesEntry[] @relation("SalesUpdatedBy")

  password_reset_tokens PasswordResetToken[]

  @@index([is_active])
}

// ===== PasswordResetToken パスワード再設定トークン =====
// login_id（メールアドレス）宛に送るリセットリンク用。平文は保存せず sha256 ハッシュで保持。
// 有効期限あり・単回使用（used_at で消し込み）。
model PasswordResetToken {
  id         String    @id @default(cuid())
  token_hash String    @unique // sha256(平文トークン)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ===== Member (要件 6-2) =====
model Member {
  id              String         @id @default(cuid())
  member_code     String         @unique // 4桁の数字（例: 0001）。自動採番＋手動変更可
  name            String
  age             Int?
  gender          Gender?
  employment_type EmploymentType
  position        String? // 役職（自由入力の肩書き）
  department      String? // 部署
  grade           Grade? // 役職（給与グレード / 大枠）
  pitch           Int? // ピッチ（給与テーブルの段位・1始まり）
  // 外注の場合のみ使用
  affiliation         String? // 所属
  purchase_unit_price Decimal? @db.Decimal(14, 2) // 仕入単価
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  // ログインユーザーとの紐づけ（1ユーザー1メンバー: @unique で担保）
  linked_user_id String? @unique
  linked_user    User?   @relation("UserMember", fields: [linked_user_id], references: [id])

  sales    SalesEntry[]
  missions Mission[]

  @@index([is_active])
  @@index([employment_type])
}

// ===== Mission 個人ミッション（マイページ） =====
// メンバー × 会計年度 × 半期（1=上期 4〜9月 / 2=下期 10〜3月）で1件。
// 管理者が課すミッションと本人が作るミッション、それぞれに本人の自己記入（振り返り/進捗）を持つ。
model Mission {
  id          String @id @default(cuid())
  fiscal_year Int // 4月始まりの会計年度
  half        Int // 1=上期 / 2=下期

  admin_mission String? // 管理者が課すミッション（管理者が設定）
  admin_review  String? // 上記への本人の振り返り/進捗（自己記入）
  self_mission  String? // 本人が作成するミッション（本人が記入）
  self_review   String? // 上記への本人の振り返り/進捗（自己記入）

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  member_id String
  member    Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([member_id, fiscal_year, half])
  @@index([member_id])
}

// ===== Client (要件 6-3) =====
model Client {
  id           String   @id @default(cuid())
  client_code  String   @unique // C+3桁（例: C001）。自動採番＋手動変更可
  company_name String
  note         String? // 備考（登録画面のみ・一覧には非表示）
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  sales    SalesEntry[]
  contacts Contact[]

  @@index([is_active])
}

// ===== Contact 取引先の担当者（1取引先に複数） =====
model Contact {
  id             String  @id @default(cuid())
  name           String // 担当者名
  contact_method String? // 連絡手段（自由記載: メール/Slack等）
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  client_id String
  client    Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
}

// ===== SalesEntry (要件 6-4) =====
model SalesEntry {
  id           String      @id @default(cuid())
  sales_key    String      @unique // ${member_code}_${client_code}_${YYYYMM}_${status}
  period_month DateTime    @db.Date // 月初1日で保存（時刻なし）
  amount       Decimal     @db.Decimal(14, 2)
  status       SalesStatus
  contract_type ContractType @default(SemiDelegation) // 準委任/請負委任/その他
  memo         String?
  year         Int
  half         Int // 1 or 2
  month        Int // 1..12
  is_deleted   Boolean     @default(false) // 論理削除

  // 外注の仕入単価（コスト）。売上(amount)には含めない。
  purchase_cost Decimal? @db.Decimal(14, 2)
  // 計上経費（コスト・任意・複数可）。売上(amount)には含めず、別枠で記録する。
  expenses     Expense[]
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  member_id String
  member    Member @relation(fields: [member_id], references: [id])

  client_id String
  client    Client @relation(fields: [client_id], references: [id])

  created_by_id String
  created_by    User   @relation("SalesCreatedBy", fields: [created_by_id], references: [id])

  updated_by_id String?
  updated_by    User?   @relation("SalesUpdatedBy", fields: [updated_by_id], references: [id])

  @@index([member_id])
  @@index([client_id])
  @@index([period_month])
  @@index([year, half])
  @@index([is_deleted])
}

// ===== Expense 計上経費（SalesEntry 1件に複数紐づく） =====
// 交通費・立替経費・その他が同月に同時発生しうるため 1:N で保持する。
// 売上(amount)には計上せず、将来の利益計算(売上−経費)用に記録する。
model Expense {
  id             String      @id @default(cuid())
  type           ExpenseType
  amount         Decimal     @db.Decimal(14, 2)
  note           String? // その他の内容など
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  sales_entry_id String
  sales_entry    SalesEntry @relation(fields: [sales_entry_id], references: [id], onDelete: Cascade)

  @@index([sales_entry_id])
}

// ===== NumberSequence (要件 6-5) 採番管理 =====
model NumberSequence {
  id         String  @id @default(cuid())
  seq_key    String  @unique // MEMBER / CLIENT / LABEL
  current_no Int     @default(0)
  prefix     String // M- / C- / L-
  pad_digits Int // ゼロ埋め桁数
  is_active  Boolean @default(true)
}
